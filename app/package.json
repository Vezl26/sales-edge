{
  "name": "sales-edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "manifest": "node scripts/make-manifest.mjs",
    "pack": "npm run build && npm run manifest && evenhub pack app.json dist -o sales-edge.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": ">=0.0.12 <0.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": ">=0.1.12 <1.0.0",
    "@evenrealities/evenhub-simulator": ">=0.7.2 <1.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
